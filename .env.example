# Credenciales de Top Secret FC — copiar este archivo a `.env` (gitignored) y completar.
# Los valores están en el `.env` de la PC principal (drygan) o se regeneran en el panel de Cloudflare.
# NUNCA escribir estos valores en el código ni commitearlos: el repo es público.

# Cloudflare — Global API Key (deploy del Worker: node scripts/deploy-worker.mjs)
CF_EMAIL=
CF_API_KEY=
CF_ACCOUNT_ID=

# R2 — token S3 limitado al bucket top-secret-media (node scripts/r2.mjs, pipeline de imágenes)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=top-secret-media

# KV namespace top-secret-data (binding TS_KV del Worker)
KV_NAMESPACE_ID=

# Opcional: carpeta con capturas/láminas de referencia (por defecto fuentes/fotos, bajada de R2)
# TS_FOTOS_DIR=
